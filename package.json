{
  "name": "dayshape-family",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node build.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-dayshape \"node --test --test-concurrency=1 tests/security/*.test.mjs\""
  },
  "dependencies": {
    "firebase": "12.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.0",
    "esbuild": "0.25.12",
    "firebase-tools": "14.26.0",
    "happy-dom": "20.8.4"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
